<Window x:Class="PrimeWidget.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrimeWidget.Views.Controls"
        xmlns:helpers="clr-namespace:PrimeWidget.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrimeWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="OnWindowMouseLeftButtonDown"
        MouseDoubleClick="OnWindowMouseDoubleClick"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <ContextMenu x:Key="WidgetContextMenu">
            <MenuItem Header="⚙ Open Settings..." Click="OnContextMenuSettingsClick"/>
            <Separator/>
            <MenuItem Header="⏱ Toggle Focus / Pomodoro Timer" Command="{Binding ToggleFocusModeCommand}"/>
            <MenuItem Header="👻 Toggle Click-Through (Ghost Mode)" Command="{Binding ToggleClickThroughCommand}"/>
            <MenuItem Header="🌍 Toggle World Timezone (Addis Ababa)" Click="OnToggleWorldTimezoneClick"/>
            <Separator/>
            <MenuItem Header="View: Combined (Analog + Digital)" Click="OnContextMenuCombinedClick"/>
            <MenuItem Header="View: Analog Only" Click="OnContextMenuAnalogClick"/>
            <MenuItem Header="View: Digital Only" Click="OnContextMenuDigitalClick"/>
            <Separator/>
            <MenuItem Header="Analog Dial: Minimalist Ticks" Click="OnDialMinimalistClick"/>
            <MenuItem Header="Analog Dial: 🇪🇹 Ethiopian Ge'ez (፲፪, ፫, ፮, ፱)" Click="OnDialEthiopianClick"/>
            <MenuItem Header="Analog Dial: Roman (XII, III, VI, IX)" Click="OnDialRomanClick"/>
            <MenuItem Header="Analog Dial: Modern Digits (12, 3, 6, 9)" Click="OnDialModernDigitsClick"/>
            <Separator/>
            <MenuItem Header="Calendar: Dual (Gregorian + Ethiopian)" Click="OnContextMenuDualCalClick"/>
            <MenuItem Header="Calendar: Ethiopian Only" Click="OnContextMenuEthCalClick"/>
            <MenuItem Header="Calendar: Gregorian Only" Click="OnContextMenuGregCalClick"/>
            <Separator/>
            <MenuItem Header="Toggle Ge'ez Numerals (፩፪፫ / 123)" Command="{Binding CycleNumeralSystemCommand}"/>
            <MenuItem Header="Toggle Light / Dark Theme" Command="{Binding ToggleThemeCommand}"/>
            <MenuItem Header="Toggle Always on Top" Command="{Binding TogglePinCommand}"/>
            <Separator/>
            <MenuItem Header="Hide Widget" Click="OnContextMenuHideClick"/>
            <MenuItem Header="✕ Exit PrimeWidget" Click="OnContextMenuExitClick"/>
        </ContextMenu>
    </Window.Resources>

    <!-- Squircle Widget Card: Snug, Clean, Floating, Transparent in Light & Dark Mode -->
    <Border x:Name="RootCardBorder"
            Margin="8"
            Background="{DynamicResource WidgetBackgroundBrush}"
            BorderBrush="{DynamicResource WidgetBorderBrush}"
            BorderThickness="1.2"
            CornerRadius="20"
            ContextMenu="{StaticResource WidgetContextMenu}">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding WidgetScale}" ScaleY="{Binding WidgetScale}"/>
        </Border.LayoutTransform>

        <Border.Effect>
            <DropShadowEffect x:Name="CardDropShadow" BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="{DynamicResource WidgetShadowOpacity}" Color="#000000"/>
        </Border.Effect>

        <!-- Interactive Hover Glow & Physics Triggers -->
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Margin="12,8,12,8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Focus / Pomodoro Mode Card -->
            <controls:FocusTimerControl
                Visibility="{Binding IsFocusMode, Converter={StaticResource BoolToVis}}"/>

            <!-- Clock Mode (Combined / Analog Only / Digital Only) -->
            <Grid Visibility="{Binding IsClockMode, Converter={StaticResource BoolToVis}}">
                <!-- Combined Clock View (Wide horizontal desktop layout: Dial + Digital + Dual Dates) -->
                <controls:CombinedClockControl
                    Visibility="{Binding IsCombined, Converter={StaticResource BoolToVis}}"/>

                <!-- Analog Only View (Large Horizontal: Dial on left, clean Dual Dates on right) -->
                <Grid Visibility="{Binding IsAnalogOnly, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Analog Dial on Left -->
                    <controls:AnalogClockControl Grid.Column="0" VerticalAlignment="Center"/>

                    <!-- Subtle Soft Divider -->
                    <Border Grid.Column="1" Width="1.2"
                            Background="{DynamicResource WidgetBorderBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Margin="0,8"/>

                    <!-- Horizontal Date & Status Readout on Right -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,4,0">
                        <!-- Period / Status (Clean, borderless typography: ጠዋት, ከቀኑ, ማታ) -->
                        <TextBlock Text="{Binding AmPmString}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,0,0,4">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Day of Week -->
                        <TextBlock Text="{Binding DayNameUpperString}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,6">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Dual Calendar Mode: Gregorian & Ethiopian Dates -->
                        <StackPanel Visibility="{Binding IsDualCalendar, Converter={StaticResource BoolToVis}}" Margin="0,0,0,2">
                            <TextBlock Text="{Binding PrimaryDateString}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding SecondaryDateString}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,3,0,0">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>

                        <!-- Single Calendar Mode -->
                        <TextBlock Visibility="{Binding IsSingleCalendar, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding PrimaryDateString}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- World Timezone Badges (Analog View Multi-zone) -->
                        <ItemsControl ItemsSource="{Binding ActiveWorldClocks}"
                                      Visibility="{Binding ShowWorldTimezone, Converter={StaticResource BoolToVis}}"
                                      Margin="0,10,0,0"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" Width="284"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="136"
                                            Background="#26000000"
                                            BorderBrush="#18FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,4.5"
                                            Margin="2,2">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayLabel}"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,4,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeString}" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PeriodString}" FontSize="8" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Digital Only View (Large Horizontal: HH:MM with AM/PM & Dual Dates) -->
                <controls:DigitalClockControl
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsDigitalOnly, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
