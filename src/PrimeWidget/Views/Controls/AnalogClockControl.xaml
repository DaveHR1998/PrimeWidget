<UserControl x:Class="PrimeWidget.Views.Controls.AnalogClockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PrimeWidget.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="190" Height="190">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Outer Soft Clock Disc with Neumorphic / Frosted Depth -->
        <Ellipse Width="182" Height="182"
                 Fill="{DynamicResource ClockFaceBrush}"
                 Stroke="{DynamicResource ClockBorderBrush}"
                 StrokeThickness="1.2">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Subtle Watermark Hour in Background -->
        <TextBlock Text="{Binding WatermarkHourString}"
                   FontSize="68"
                   FontWeight="SemiBold"
                   FontFamily="Segoe UI Variable Display, Nyala, Segoe UI, sans-serif"
                   Foreground="{DynamicResource SubtleGlowBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Margin="0,0,0,4"/>

        <!-- Clock Face Dial Canvas with ticks and numerals -->
        <Canvas x:Name="TicksCanvas" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Cardinal Dial Labels (12, 3, 6, 9 or Ge'ez ፲፪, ፫, ፮, ፱) -->
        <Canvas Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- 12 o'clock -->
            <TextBlock Text="{Binding DialLabel12}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                       Foreground="{DynamicResource ClockTicksBrush}"
                       Canvas.Left="0" Canvas.Top="12" Width="180" TextAlignment="Center"/>
            <!-- 3 o'clock -->
            <TextBlock Text="{Binding DialLabel3}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                       Foreground="{DynamicResource ClockTicksBrush}"
                       Canvas.Right="12" Canvas.Top="81" Width="30" TextAlignment="Center"/>
            <!-- 6 o'clock -->
            <TextBlock Text="{Binding DialLabel6}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                       Foreground="{DynamicResource ClockTicksBrush}"
                       Canvas.Left="0" Canvas.Bottom="12" Width="180" TextAlignment="Center"/>
            <!-- 9 o'clock -->
            <TextBlock Text="{Binding DialLabel9}"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                       Foreground="{DynamicResource ClockTicksBrush}"
                       Canvas.Left="12" Canvas.Top="81" Width="30" TextAlignment="Center"/>
        </Canvas>

        <!-- Hour Hand (Rounded soft baton with depth) -->
        <Canvas Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="6" Height="48"
                    Background="{DynamicResource ClockHourHandBrush}"
                    CornerRadius="3"
                    Canvas.Left="87" Canvas.Top="50"
                    RenderTransformOrigin="0.5, 0.83">
                <Border.RenderTransform>
                    <RotateTransform Angle="{Binding HourHandAngle}"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                </Border.Effect>
            </Border>
        </Canvas>

        <!-- Minute Hand (Longer elegant baton) -->
        <Canvas Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="4.2" Height="68"
                    Background="{DynamicResource ClockMinuteHandBrush}"
                    CornerRadius="2.1"
                    Canvas.Left="87.9" Canvas.Top="30"
                    RenderTransformOrigin="0.5, 0.88">
                <Border.RenderTransform>
                    <RotateTransform Angle="{Binding MinuteHandAngle}"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                </Border.Effect>
            </Border>
        </Canvas>

        <!-- Frosted Center Disc Hub (Direct match to Image 3 left!) -->
        <Ellipse Width="38" Height="38"
                 Fill="{DynamicResource ClockCenterCapBrush}"
                 Stroke="{DynamicResource ClockBorderBrush}"
                 StrokeThickness="1"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- Second Hand (Needle thin accent colored hand) -->
        <Canvas Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVis}}">
            <Border Width="1.8" Height="84"
                    Background="{DynamicResource SecondHandBrush}"
                    CornerRadius="0.9"
                    Canvas.Left="89.1" Canvas.Top="18"
                    RenderTransformOrigin="0.5, 0.85">
                <Border.RenderTransform>
                    <RotateTransform Angle="{Binding SecondHandAngle}"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
            </Border>
        </Canvas>

        <!-- Center Accent Pin -->
        <Ellipse Width="7" Height="7"
                 Fill="{DynamicResource SecondHandBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
