<UserControl x:Class="PrimeWidget.Views.Controls.FocusTimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PrimeWidget.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             MinWidth="340">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TimerActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource WidgetCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource WidgetCardHoverBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimerChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WidgetBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource WidgetCardHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,6,12,6">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <!-- Header bar: Status badge & Return button -->
            <Grid Width="320" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="🎯 " FontSize="14"/>
                    <TextBlock Text="{Binding FocusStatusText}"
                               FontSize="12"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Duration chips -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="15m" Style="{StaticResource TimerChipButtonStyle}" Command="{Binding SetFocus15Command}"/>
                    <Button Content="25m" Style="{StaticResource TimerChipButtonStyle}" Command="{Binding SetFocus25Command}"/>
                    <Button Content="45m" Style="{StaticResource TimerChipButtonStyle}" Command="{Binding SetFocus45Command}"/>
                    <Button Content="⏱ Clock" Style="{StaticResource TimerChipButtonStyle}"
                            Command="{Binding ToggleFocusModeCommand}" Margin="8,0,0,0"
                            Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Large Glass Countdown Readout -->
            <TextBlock Text="{Binding FocusTimeRemainingString}"
                       FontSize="64"
                       FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Nyala, Segoe UI, sans-serif"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,8">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Glowing Progress Bar Track -->
            <Border Width="300" Height="6" CornerRadius="3"
                    Background="{DynamicResource WidgetCardBrush}"
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center">
                <Grid HorizontalAlignment="Left" Width="{Binding FocusProgressBarWidth}">
                    <Border CornerRadius="3" Background="{DynamicResource AccentBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="0" Color="{DynamicResource AccentColor}" Opacity="0.6"/>
                        </Border.Effect>
                    </Border>
                </Grid>
            </Border>

            <!-- Action Buttons: Start/Pause, Reset -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Start / Pause Toggle -->
                <Button Command="{Binding ToggleFocusRunningCommand}" Style="{StaticResource TimerActionButtonStyle}" Width="110">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FocusPlayButtonIcon}" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding FocusPlayButtonText}" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Reset -->
                <Button Content="↺ Reset" Command="{Binding ResetFocusCommand}"
                        Style="{StaticResource TimerActionButtonStyle}" Width="90"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
