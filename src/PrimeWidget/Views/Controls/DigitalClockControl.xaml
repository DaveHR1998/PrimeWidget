<UserControl x:Class="PrimeWidget.Views.Controls.DigitalClockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PrimeWidget.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid VerticalAlignment="Center">
        <StackPanel Orientation="Vertical">
            <!-- Large Modern Horizontal Digits Display (Auto-centers when minute is 00) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Hours -->
                <TextBlock Text="{Binding StackedHourString}"
                           FontSize="56"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Nyala, Segoe UI, sans-serif"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1.5" Opacity="0.22" Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Separator Colon (Hidden at 00 minutes in Ge'ez mode) -->
                <TextBlock Text=":"
                           FontSize="50"
                           FontWeight="Normal"
                           FontFamily="Segoe UI Variable Display, Nyala, Segoe UI, sans-serif"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="4,-4,4,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasMinutes, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Minutes (Hidden at 00 minutes in Ge'ez mode) -->
                <TextBlock Text="{Binding StackedMinuteString}"
                           FontSize="56"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Nyala, Segoe UI, sans-serif"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Visibility="{Binding HasMinutes, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1.5" Opacity="0.22" Color="#000000"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Period & Seconds (Completely Border-Free & Sleek!) -->
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                    <!-- Clean, borderless AM / PM / ጠዋት / ከቀኑ / ማታ label -->
                    <TextBlock Text="{Binding AmPmString}"
                               FontSize="15"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource AccentBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Seconds indicator (borderless, zero-suppressed) -->
                    <TextBlock Text="{Binding SecondsDisplayString}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0"
                               Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVis}}">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Refined Horizontal Date Strip (Day + Dual Calendar in One Balanced Line) -->
            <StackPanel Orientation="Vertical" Margin="0,6,0,0" HorizontalAlignment="Center">
                <!-- Dual Calendar Mode: Day of Week + Gregorian + Ethiopian Dates in One Centered Line -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsDualCalendar, Converter={StaticResource BoolToVis}}">
                    <!-- Day of Week in Accent Color -->
                    <TextBlock Text="{Binding DayNameUpperString}"
                               FontSize="12"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Dot Divider -->
                    <TextBlock Text="  •  "
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Gregorian Date -->
                    <TextBlock Text="{Binding PrimaryDateString}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Dot Divider -->
                    <TextBlock Text="  •  "
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Ethiopian Date -->
                    <TextBlock Text="{Binding SecondaryDateString}"
                               FontSize="13"
                               FontWeight="Medium"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Single Calendar Mode: Day of Week + Primary Date -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsSingleCalendar, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DayNameUpperString}"
                               FontSize="12"
                               FontWeight="Bold"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="  •  "
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PrimaryDateString}"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Text, Nyala, Segoe UI, sans-serif"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- World Timezone Badges (Uniform 2-Column Grid with Translucent Glass Pills) -->
                <ItemsControl ItemsSource="{Binding ActiveWorldClocks}"
                              Visibility="{Binding ShowWorldTimezone, Converter={StaticResource BoolToVis}}"
                              Margin="0,11,0,0"
                              HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Width="316" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="152"
                                    Background="#26000000"
                                    BorderBrush="#18FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,5"
                                    Margin="3,2.5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                                </Border.Effect>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- City Name (Clean, left-aligned, no broken emojis) -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayLabel}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                               Foreground="#FFFFFF"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,6,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <!-- Time & Period -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeString}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PeriodString}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
