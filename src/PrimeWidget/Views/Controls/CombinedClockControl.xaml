<UserControl x:Class="PrimeWidget.Views.Controls.CombinedClockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PrimeWidget.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Analog Dial on Left -->
        <controls:AnalogClockControl Grid.Column="0" VerticalAlignment="Center"/>

        <!-- Subtle Soft Divider -->
        <Border Grid.Column="1" Width="1.2"
                Background="{DynamicResource WidgetBorderBrush}"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Margin="0,8"/>

        <!-- Digital Readout on Right -->
        <controls:DigitalClockControl Grid.Column="2" VerticalAlignment="Center" Margin="2,0,4,0"/>
    </Grid>
</UserControl>
