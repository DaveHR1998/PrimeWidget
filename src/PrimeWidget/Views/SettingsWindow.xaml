<Window x:Class="PrimeWidget.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PrimeWidget.Views.Controls"
        xmlns:helpers="clr-namespace:PrimeWidget.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrimeWidget"
        Width="920" Height="620"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#CCCCCC"
        Icon="pack://application:,,,/Resources/primewidget.png"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <Style x:Key="DarkTimeZoneListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D30"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#094771"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style (VS Code sidebar section style) -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#858585"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Segmented Button Style (VS Code item / chip style) -->
        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2D2E"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Button Style (Minimize / Maximize) -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Caption Close Button Style -->
        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Action Icon Button Style (VS Code / Windows 11 Fluent style) -->
        <Style x:Key="ToolbarIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="BorderBrush" Value="#3E3E42"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#37373D"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E1E1E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar Track Page Repeat Button Style -->
        <Style x:Key="ScrollBarPageButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim Dark ScrollBar Thumb Style -->
        <Style x:Key="SlimDarkScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="thumbBorder"
                                Background="#3E3E42"
                                CornerRadius="3"
                                Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#5A5A62"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#787882"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit Slim Dark ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#3E3E42"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="MinWidth" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimDarkScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="MinHeight" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimDarkScrollBarThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarPageButtonStyle}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Single Unified Dark Top Bar -->
            <RowDefinition Height="42"/>
            <!-- 2. Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Single Unified Dark Top Bar (Zero Duplication) -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#2D2D2D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Brand Logo & Title -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: Draggable Area -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Quick Actions & Window Captions -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image Source="pack://application:,,,/Resources/primewidget.png"
                           Width="20" Height="20"
                           VerticalAlignment="Center"
                           Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="PRIME" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="WIDGET" FontSize="14" FontWeight="Light" Foreground="#858585" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Quick Actions + Window Captions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- Icon-Only Desktop Widget Visibility Toggle Button -->
                    <Button Style="{StaticResource ToolbarIconButtonStyle}"
                            Click="OnToggleWidgetVisibilityClick"
                            ToolTip="Toggle Desktop Widget Visibility"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Height="30" Width="30"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                        <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                              Fill="#CCCCCC"
                              Width="15" Height="15"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>

                    <!-- Primary Save & Apply Button -->
                    <Button Content="Save &amp; Apply"
                            Background="#007ACC"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            FontSize="11.5"
                            Padding="12,0"
                            Height="28"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnSaveAndApplyClick"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Subtle Separator -->
                    <Border Width="1" Height="18" Background="#3E3E42" Margin="0,0,4,0" VerticalAlignment="Center"/>

                    <!-- Standard Window Control Buttons -->
                    <Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="OnTitleMinimizeClick"/>
                    <Button Content="▢" Style="{StaticResource CaptionButtonStyle}" Click="OnTitleMaximizeClick"/>
                    <Button Content="✕" Style="{StaticResource CaptionCloseButtonStyle}" Click="OnTitleCloseClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Body: Settings on Left, Live Preview on Right -->
        <Grid Grid.Row="1" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Settings Panel (Responsive 1.1* ratio, Min 360, Max 460) -->
                <ColumnDefinition Width="1.1*" MinWidth="360" MaxWidth="460"/>
                <ColumnDefinition Width="14"/>
                <!-- Right: Live Preview Panel (Responsive 1* ratio, Min 320) -->
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Settings Scrollable Panel -->
            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#2D2D2D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12,6,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" Margin="0,0,14,0">
                        <!-- 1. Widget View Mode -->
                        <TextBlock Text="WIDGET VIEW MODE" Style="{StaticResource SectionHeaderStyle}" Margin="0,4,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnViewCombined" Content="Combined (Analog + Digital)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnCombinedViewClick"/>
                            <Button x:Name="BtnViewAnalog" Content="Analog Only"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnAnalogViewClick"/>
                            <Button x:Name="BtnViewDigital" Content="Digital Only"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnDigitalViewClick"/>
                        </WrapPanel>

                        <!-- 2. Analog Dial Style -->
                        <TextBlock Text="ANALOG DIAL STYLE" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnDialMinimalist" Content="Minimalist Ticks"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnMinimalistDialClick"/>
                            <Button x:Name="BtnDialEthiopian" Content="🇪🇹 Ethiopian Ge'ez (፲፪, ፫, ፮, ፱)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnEthiopianDialClick"/>
                            <Button x:Name="BtnDialRoman" Content="Roman (XII, III, VI, IX)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnRomanDialClick"/>
                            <Button x:Name="BtnDialModern" Content="Modern Digits (12, 3, 6, 9)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnModernDigitsClick"/>
                        </WrapPanel>

                        <!-- 3. Calendar System -->
                        <TextBlock Text="CALENDAR SYSTEM (DUAL OR SINGLE)" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnCalDual" Content="Dual (Gregorian + Ethiopian)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnDualCalendarClick"/>
                            <Button x:Name="BtnCalEthiopian" Content="Ethiopian (ዓ.ም.)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnEthiopianCalendarClick"/>
                            <Button x:Name="BtnCalGregorian" Content="Gregorian Only"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnGregorianCalendarClick"/>
                        </WrapPanel>

                        <!-- 4. Visual Theme & Windows 11 Backdrop -->
                        <TextBlock Text="WINDOWS 11 NATIVE BACKDROP" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnBackdropAcrylic" Content="✨ Acrylic (Desktop Blur)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnBackdropAcrylicClick"/>
                            <Button x:Name="BtnBackdropMica" Content="🌌 Mica (Wallpaper Tint)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnBackdropMicaClick"/>
                            <Button x:Name="BtnBackdropMicaAlt" Content="🗂 Mica Alt"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnBackdropMicaAltClick"/>
                            <Button x:Name="BtnBackdropNone" Content="Glass Tint Only"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnBackdropNoneClick"/>
                        </WrapPanel>

                        <TextBlock Text="VISUAL GLASS THEME" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="🌓 Automatically Sync Theme with Windows OS (Dark/Light)"
                                  IsChecked="{Binding SyncWithWindowsTheme, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,0,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnThemeDark" Content="🌙 Dark Glass (Obsidian)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnDarkThemeClick"/>
                            <Button x:Name="BtnThemeLight" Content="☀ Light Glass (Frosted)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnLightThemeClick"/>
                        </WrapPanel>

                        <!-- 5. Material Accent Tone -->
                        <TextBlock Text="ACCENT TONE" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnAccentMonochrome" Content="Monochrome (B&amp;W)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnMonochromeAccentClick"/>
                            <Button x:Name="BtnAccentSilver" Content="Ice Silver"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnSilverAccentClick"/>
                            <Button x:Name="BtnAccentRed" Content="Crimson Red"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnRedAccentClick"/>
                            <Button x:Name="BtnAccentGold" Content="Solar Amber"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnGoldAccentClick"/>
                        </WrapPanel>

                        <!-- 6. Frosted Glass Opacity -->
                        <Grid Margin="0,14,0,4">
                            <TextBlock Text="FROSTED GLASS OPACITY" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                            <TextBlock Text="{Binding Opacity, StringFormat='{}{0:P0}'}"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#4EC9B0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnOpacityZero" Content="100% Transparent (No Box)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnOpacityZeroClick"/>
                            <Button x:Name="BtnOpacity30" Content="30% Subtle"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnOpacity30Click"/>
                            <Button x:Name="BtnOpacity60" Content="60% Frosted"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnOpacity60Click"/>
                            <Button x:Name="BtnOpacity90" Content="90% Card"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnOpacity90Click"/>
                        </WrapPanel>
                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Opacity, Mode=TwoWay}"
                                TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="0,2,0,8"/>

                        <!-- 7. Widget Size Scaling -->
                        <Grid Margin="0,14,0,4">
                            <TextBlock Text="WIDGET SIZE &amp; SCALE (መጠን)" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                            <TextBlock Text="{Binding WidgetScale, StringFormat='{}{0:P0}'}"
                                       FontSize="11.5" FontWeight="Bold" Foreground="#4EC9B0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnScaleCompact" Content="Compact (85%)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnScaleCompactClick"/>
                            <Button x:Name="BtnScaleStandard" Content="Standard (100%)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnScaleStandardClick"/>
                            <Button x:Name="BtnScaleHero" Content="Hero (125%)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnScaleHeroClick"/>
                        </WrapPanel>
                        <Slider Minimum="0.70" Maximum="1.50" Value="{Binding WidgetScale, Mode=TwoWay}"
                                TickFrequency="0.05" IsSnapToTickEnabled="False" Margin="0,2,0,8"/>

                        <!-- 8. Ethiopian Script Language -->
                        <TextBlock Text="ETHIOPIAN SCRIPT LANGUAGE" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnScriptAmharic" Content="አማርኛ (Amharic Ge'ez)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnAmharicScriptClick"/>
                            <Button x:Name="BtnScriptEnglish" Content="English Transliteration"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnEnglishScriptClick"/>
                        </WrapPanel>

                        <!-- 9. Time Format -->
                        <TextBlock Text="TIME FORMAT" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnTime12H" Content="12-Hour (AM/PM)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="On12HourClick"/>
                            <Button x:Name="BtnTime24H" Content="24-Hour"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="On24HourClick"/>
                            <Button x:Name="BtnTimeEth12H" Content="Ethiopian 12-Hour (ጠዋት/ከሰዓት)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnEth12HourClick"/>
                        </WrapPanel>

                        <!-- 10. Numeral System -->
                        <TextBlock Text="NUMERAL SYSTEM (ቁጥሮች)" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnNumeralsWestern" Content="123 Western Digits"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnWesternNumeralsClick"/>
                            <Button x:Name="BtnNumeralsGeez" Content="፩፪፫ Ge'ez Numerals (ግዕዝ ቁጥሮች)"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnGeezNumeralsClick"/>
                        </WrapPanel>

                        <!-- 11. Focus / Pomodoro Mode -->
                        <TextBlock Text="FOCUS &amp; POMODORO TIMER (የትኩረት ጊዜ)" Style="{StaticResource SectionHeaderStyle}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="⏱ Toggle Focus Mode Card"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding ToggleFocusModeCommand}"/>
                            <Button Content="15 Minutes" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetFocus15Command}"/>
                            <Button Content="25 Minutes" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetFocus25Command}"/>
                            <Button Content="45 Minutes" Style="{StaticResource SegmentButtonStyle}" Command="{Binding SetFocus45Command}"/>
                        </WrapPanel>

                        <!-- 12. Hourly Chime (የሰዓት ደወል) -->
                        <TextBlock Text="HOURLY CHIME (የሰዓት ደወል ድምፅ)" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="🔔 Play subtle chime sound every hour"
                                  IsChecked="{Binding EnableHourlyChime, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,4"/>
                        <CheckBox Content="🌙 Quiet Hours (Silence between 10:00 PM and 7:00 AM)"
                                  IsChecked="{Binding ChimeQuietHoursEnabled, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,8"/>
                        <WrapPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <Button x:Name="BtnChimeAcoustic" Content="Acoustic Bell"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnChimeAcousticClick"/>
                            <Button x:Name="BtnChimeCrystal" Content="Crystal Digital"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnChimeCrystalClick"/>
                            <Button x:Name="BtnChimeChurch" Content="Church Bell"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Click="OnChimeChurchClick"/>
                            <Button Content="🔊 Test Chime"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Command="{Binding TestChimeCommand}"
                                    Foreground="#4EC9B0"/>
                        </WrapPanel>

                        <!-- 13. Desktop Ergonomics & Productivity -->
                        <TextBlock Text="DESKTOP ERGONOMICS &amp; BEHAVIOR" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="👻 Ghost / Click-Through Mode (clicks pass to desktop behind)"
                                  IsChecked="{Binding IsClickThrough, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,4,0,8"/>
                        <CheckBox Content="⌨ Global Hotkey: Ctrl + Alt + W (Quick 5-Second Glance)"
                                  IsChecked="{Binding EnableGlobalHotkey, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,8"/>
                        <CheckBox Content="Launch PrimeWidget on Windows Startup"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,8"/>
                        <CheckBox Content="Smooth Continuous Second Hand"
                                  IsChecked="{Binding SmoothSweepSecondHand, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,8"/>
                        <CheckBox Content="Show Second Hand / Digits"
                                  IsChecked="{Binding ShowSeconds, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,8"/>
                        <CheckBox Content="Keep Desktop Widget Always on Top"
                                  IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,16"/>

                        <!-- 14. World Time Zones -->
                        <TextBlock Text="WORLD TIME ZONES (ዓለም አቀፍ የሰዓት ቀጣናዎች)" Style="{StaticResource SectionHeaderStyle}"/>
                        <CheckBox Content="🌍 Show World Time Zone Badges on Widget"
                                  IsChecked="{Binding ShowWorldTimezone, Mode=TwoWay}"
                                  Foreground="#CCCCCC" Margin="0,2,0,10"/>

                        <StackPanel Visibility="{Binding ShowWorldTimezone, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                            <!-- Quick Add Popular Cities -->
                            <TextBlock Text="Quick Add Popular Cities:" FontSize="11" Foreground="#858585" Margin="0,0,0,6"/>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="+ 🇪🇹 Addis Ababa" Tag="ADDIS" Click="OnQuickAddCityClick" Style="{StaticResource SegmentButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                <Button Content="+ 🇺🇸 New York" Tag="NYC" Click="OnQuickAddCityClick" Style="{StaticResource SegmentButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                <Button Content="+ 🇬🇧 London" Tag="LON" Click="OnQuickAddCityClick" Style="{StaticResource SegmentButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                <Button Content="+ 🇦🇪 Dubai" Tag="DXB" Click="OnQuickAddCityClick" Style="{StaticResource SegmentButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                <Button Content="+ 🇯🇵 Tokyo" Tag="TYO" Click="OnQuickAddCityClick" Style="{StaticResource SegmentButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                                <Button Content="+ 🇰🇪 Nairobi" Tag="NBO" Click="OnQuickAddCityClick" Style="{StaticResource SegmentButtonStyle}" Height="28" Padding="10,0" Margin="0,0,6,6"/>
                            </WrapPanel>

                            <!-- Search Input & Add Button Bar -->
                            <TextBlock Text="Search &amp; Add From 140+ Time Zones (Double-click to add):" FontSize="11" Foreground="#858585" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Dark Search Input Box -->
                                <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Height="34" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#858585" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        
                                        <!-- Watermark and TextBox -->
                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Type city, country, or offset (e.g. Addis, London, Tokyo, UTC+3)..."
                                                       Foreground="#555555"
                                                       FontSize="11.5"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="2,0,0,0"
                                                       Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVis}}"/>
                                            <TextBox x:Name="TxtSearchTimeZone"
                                                     Text="{Binding TimeZoneSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     Foreground="#FFFFFF"
                                                     CaretBrush="#FFFFFF"
                                                     BorderThickness="0"
                                                     VerticalAlignment="Center"
                                                     FontSize="12"
                                                     Padding="2,0,4,0"/>
                                        </Grid>

                                        <!-- Clear Button -->
                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVis}}"
                                                Click="OnClearSearchClick"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#858585"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Add Selected Button -->
                                <Button Grid.Column="1"
                                        Content="+ Add Zone"
                                        Style="{StaticResource SegmentButtonStyle}"
                                        Click="OnAddSelectedZoneClick"
                                        Height="34"
                                        Margin="0"
                                        Padding="14,0"
                                        FontWeight="SemiBold"/>
                            </Grid>

                            <!-- Match Status -->
                            <TextBlock Text="{Binding FilterCountStatus}" FontSize="10.5" Foreground="#6C6C6C" Margin="2,0,0,4"/>

                            <!-- Filtered Scrollable Timezone List -->
                            <Border Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                                <ListBox x:Name="LstTimeZones"
                                         ItemsSource="{Binding FilteredTimeZones}"
                                         SelectedItem="{Binding SelectedTimeZoneItem, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource DarkTimeZoneListBoxItemStyle}"
                                         MouseDoubleClick="OnTimeZoneListDoubleClick"
                                         MaxHeight="170"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,3,2,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Offset Badge -->
                                                <Border Grid.Column="0" Background="#2A2D2E" CornerRadius="3" Padding="5,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UtcOffsetString}" FontSize="10.5" FontWeight="Bold" Foreground="#4EC9B0"/>
                                                </Border>
                                                <!-- City / Flag / Full Name -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding FlagEmoji}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CityName}" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5" Foreground="#858585" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- Active Selected World Zones Chips -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Active Selected Time Zones (Ordered Chronologically):" FontSize="11" Foreground="#858585" VerticalAlignment="Center"/>
                                <Button Content="⇅ Sort Chronologically"
                                        Click="OnSortWorldZonesClick"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#4EC9B0"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ActiveWorldClocks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FlagEmoji}" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TimeString}" FontSize="11" FontWeight="Bold" Foreground="#4EC9B0" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PeriodString}" FontSize="9.5" Foreground="#858585" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <Button Content="✕"
                                                        Tag="{Binding TimeZoneId}"
                                                        Click="OnRemoveZoneClick"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="#858585"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Cursor="Hand"
                                                        Padding="3,0"
                                                        VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Live Interactive Preview Grid (Background and Border Removed) -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,16">
                    <TextBlock Text="LIVE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="#858585"/>
                    <TextBlock Text="  Reflects active settings in real time" FontSize="11" Foreground="#6A6A6A" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Stage Canvas (Clean & Transparent) with Responsive Viewbox Scaling -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Widget in Preview -->
                        <Border Background="{DynamicResource WidgetBackgroundBrush}"
                                BorderBrush="{DynamicResource WidgetBorderBrush}"
                                BorderThickness="1.2"
                                CornerRadius="20"
                                Padding="12,8,12,8">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding WidgetScale}" ScaleY="{Binding WidgetScale}"/>
                            </Border.LayoutTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>

                            <Grid>
                                <!-- Focus Mode in Preview -->
                                <controls:FocusTimerControl
                                    Visibility="{Binding IsFocusMode, Converter={StaticResource BoolToVis}}"/>

                                <!-- Clock Mode in Preview -->
                                <Grid Visibility="{Binding IsClockMode, Converter={StaticResource BoolToVis}}">
                                    <!-- Combined View -->
                                    <controls:CombinedClockControl
                                        Visibility="{Binding IsCombined, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Analog Only View -->
                                    <Grid Visibility="{Binding IsAnalogOnly, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:AnalogClockControl Grid.Column="0" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Width="1.2" Background="{DynamicResource WidgetBorderBrush}" Margin="0,8"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,4,0">
                                            <TextBlock Text="{Binding AmPmString}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding DayNameUpperString}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <StackPanel Visibility="{Binding IsDualCalendar, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding PrimaryDateString}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding SecondaryDateString}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <TextBlock Visibility="{Binding IsSingleCalendar, Converter={StaticResource BoolToVis}}" Text="{Binding PrimaryDateString}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                            <!-- World Timezones in Preview -->
                                            <ItemsControl ItemsSource="{Binding ActiveWorldClocks}"
                                                          Visibility="{Binding ShowWorldTimezone, Converter={StaticResource BoolToVis}}"
                                                          Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" Width="240"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="116"
                                                                Background="#26000000"
                                                                BorderBrush="#18FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="6,3.5"
                                                                Margin="2,2">
                                                            <Grid VerticalAlignment="Center">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="9" FontWeight="SemiBold"
                                                                           Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,2,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding TimeString}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Digital Only View -->
                                    <controls:DigitalClockControl
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding IsDigitalOnly, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Viewbox>
                </Grid>

                <!-- Preview Hint -->
                <TextBlock Grid.Row="2"
                           Text="Tip: You can reposition the actual widget anywhere on your desktop by dragging it."
                           FontSize="11"
                           Foreground="#858585"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
